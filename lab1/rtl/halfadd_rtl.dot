digraph "halfadd" {
label="halfadd";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="c", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="s", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="x", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="y", color="black", fontcolor="black" ];
c8 [ shape=record, label="{{<p5> A|<p6> B}|$2\n$and|{<p7> Y}}" ];
c9 [ shape=record, label="{{<p5> A|<p6> B}|$1\n$xor|{<p7> Y}}" ];
c8:p7:e -> n1:w [color="black", label=""];
c9:p7:e -> n2:w [color="black", label=""];
n3:e -> c8:p5:w [color="black", label=""];
n3:e -> c9:p5:w [color="black", label=""];
n4:e -> c8:p6:w [color="black", label=""];
n4:e -> c9:p6:w [color="black", label=""];
}
